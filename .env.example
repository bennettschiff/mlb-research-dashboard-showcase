# Copy to .env.local (gitignored). The UI builds and the test suite runs with
# none of these set; they are only needed for the /api routes and scripts.

# Main Supabase project (picks ledger, scan results). Server-side only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Separate research Supabase project (feature panels). Scripts only.
LAB_SUPABASE_URL=https://<lab-project-ref>.supabase.co
LAB_SUPABASE_SERVICE_ROLE_KEY=

# The Odds API (https://the-odds-api.com). Server-side only.
ODDS_API_KEY=

# Shared secret for /api/cron, and the optional access code for the UI gate.
CRON_SECRET=
APP_ACCESS_CODE=

# Deployed origin, used by the scheduled scripts.
APP_URL=https://<your-deployment>.vercel.app
