# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp
.cache

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
.vercel
.env*.local
.claude/

# Local script outputs + caches
scripts/bullpen-cache/
scripts/import-errors.json
scripts/tb-calibration.json
scripts/tb-replay-out.csv

# Root-level ad-hoc test scripts
/test-apis.mjs
/test-game-model.mjs

# Throwaway Vite entry for rendering a single component in isolation while
# building it (self-labeled "temporary" — it bypasses App.jsx and its auth gate).
/verify-viz.html
/src/verify-viz-entry.jsx

# Daily dev-digest archive (generated by the dev-digest scheduled task)
dev-digests/

# Regenerated on every plumbing-tripwire run (CI uploads it as an artifact, and
# the auditor regenerates it locally). Committing it would churn daily and race
# the pre-dawn chain's git pull --rebase.
docs/plumbing-tripwire-latest.json
docs/cron-watchdog-latest.json
scripts/pitch-cache/
scripts/pitch-cache-batter/
scripts/pitch-cache-window/

# withFileLock's cross-process locks (scripts/lib/lab-core.mjs) — a directory
# that exists only while a lab-analyst.mjs/promotion-gate.mjs read-modify-write
# is in flight, self-removed on exit. Should never exist at commit time; this
# is a backstop in case a run got killed mid-lock and left one behind.
lab/*/.ledger.lock/
lab/*/.promotion-gate.lock/

# macOS Finder state. Tracked by mistake in the initial commit, so every session
# showed a dirty tree and risked committing Finder scroll/icon positions as if they
# were work. Untracked 2026-08-09; the file itself is harmless to keep locally.
.DS_Store

# mining-cron's local copy of the feature matrix (--matrix-cache). Tens of MB of
# derived numbers, restored between CI runs by actions/cache and rebuildable from
# LAB at any time. Never a commit.
.mining-matrix/

# Local research virtualenv (requirements-lab.txt).
.venv/

# Python bytecode. scripts/ gained an importable package (scripts/lib/*.py) on
# 2026-09-08, so importing or compiling any ETL now leaves these behind.
__pycache__/
*.pyc
